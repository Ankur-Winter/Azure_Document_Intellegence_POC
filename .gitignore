# Local Azure credentials. Keep .env.example as a placeholder template only.
.env
.env.*
!.env.example

# Python and editor-generated files
.venv/
__pycache__/
*.py[cod]
.DS_Store
.vscode/

# User-supplied files stay local, except the three public demo inputs
data/documents/*
!data/documents/.gitkeep
!data/documents/T01_Text_PDF.pdf
!data/documents/T02_PDF_with_tables.pdf
!data/documents/T03_PDF_with_Image.pdf

# Ground truths stay local, except references needed for the public demo
data/ground_truth/*
!data/ground_truth/.gitkeep
!data/ground_truth/README.md
!data/ground_truth/T01_Text_PDF.pdf.txt
!data/ground_truth/T02_PDF_with_tables.pdf.txt
!data/ground_truth/T02_PDF_with_tables.tables.json
!data/ground_truth/T03_PDF_with_Image.pdf.txt

# API output and extracted text stay local, except the three-case offline demo snapshot
results/**
!results/.gitkeep
!results/20261023-195540-686580/
!results/20261023-195540-686580/**
