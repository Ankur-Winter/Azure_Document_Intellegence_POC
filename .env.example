# Copy this file to .env and replace the placeholders with your Azure resource values.
AZURE_DI_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
AZURE_DI_KEY=REPLACE_WITH_KEY_1_OR_KEY_2

# Optional label for your notes/reports. The endpoint identifies the resource region.
AZURE_DI_REGION=<azure-region>

